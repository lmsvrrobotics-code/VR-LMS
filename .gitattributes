# Normalize line endings. Files consumed by Linux containers MUST be LF —
# CRLF in a Dockerfile RUN line or an entrypoint script fails at build/run
# time with a confusing "not found" error.
* text=auto

Dockerfile   text eol=lf
*.dockerignore text eol=lf
*.sh         text eol=lf
*.sql        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
